rules_version = '2';
// Firestore のセキュリティルール（誰がどのデータを読み書きできるか）。
// Firebase コンソールの「Firestore Database」→「ルール」に、このファイルの中身を貼り付けて「公開」する。
//
// ログインした人の内部ID は、ログイン用ID（「内部ID@ドメイン」の形）の @ より前の部分。
// app/main の admins（管理者）・members（在籍中の人）の一覧と照らし合わせて判定する。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myId() { return request.auth.token.email.split('@')[0]; }
    // 書き込みが成功した後の app/main（一括書き込みで app/main も同時に作る最初の1回に対応するため getAfter を使う）
    function mainAfter() { return getAfter(/databases/$(database)/documents/app/main).data; }
    function mainNow() { return get(/databases/$(database)/documents/app/main).data; }

    // 店舗全体のデータ：在籍中の人は読める。書き込めるのは管理者だけ
    match /app/main {
      allow read: if signedIn() && (resource == null || myId() in resource.data.members);
      allow create: if signedIn() && myId() in request.resource.data.admins; // 最初の1回（まだ誰もデータを置いていないとき）
      allow update: if signedIn() && myId() in resource.data.admins;
      allow delete: if false;
    }

    // 初期設定済みの印：ログイン前に確かめるので誰でも読める。
    // 作れるのは最初の1回だけで、変更・削除はできない（初期設定をやり直してデータを上書きすることを防ぐ）
    match /app/public {
      allow read: if true;
      allow create: if signedIn() && myId() in mainAfter().admins;
      allow update, delete: if false;
    }

    // 社員番号 → 内部ID：ログイン前に使うので、番号を指定した1件だけは誰でも読める。
    // 一覧（list）は取れないので、在籍者の社員番号をまとめて調べることはできない。書き込めるのは管理者だけ
    match /logins/{empNo} {
      allow get: if true;
      allow list: if false;
      allow write: if signedIn() && myId() in mainAfter().admins;
    }

    // 勤務希望：本人と管理者だけが読み書きできる
    match /prefs/{userId} {
      allow read: if signedIn() && (myId() == userId || myId() in mainNow().admins);
      allow write: if signedIn() && ((myId() == userId && myId() in mainAfter().members) || myId() in mainAfter().admins);
    }
  }
}
